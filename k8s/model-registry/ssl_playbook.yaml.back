- name: adds tls certificates to nodes
  hosts: all
  tasks:
    - name: Make sure the directories exist
      become: true
      file:
        path: /etc/docker/certs.d/192.168.2.53
        state: directory
    - name: Copy certificate config
      ansible.builtin.copy:
        src: certs/registry.crt
        dest: /etc/docker/certs.d/192.168.2.53/ca.crt
        owner: root
        group: root
        mode: "0644"
      become: true
      become_user: root
    - name: copy certificates to os level
      become: true
      ansible.builtin.copy:
        src: certs/registry.crt
        dest: /usr/local/share/ca-certificates/registry.crt
    - name: update certificates
      become: true
      shell: update-ca-certificates


    - name: restart docker services
      become: true
      shell: systemctl restart docker.service

